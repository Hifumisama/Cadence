{
  "name": "cadence",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "clean": "node -e \"require('fs').promises.rm('.next',{recursive:true,force:true})\"",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "knip": "knip",
    "test": "tsx --test \"lib/**/*.test.ts\" worker/*.test.ts worker/comfyui/*.test.ts",
    "llm:try": "tsx scripts/llm-try.ts",
    "llm:task": "tsx scripts/llm-task.ts",
    "worker": "tsx watch worker/index.ts",
    "worker:start": "tsx worker/index.ts",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx db/migrate.ts",
    "dev:db": "docker compose -f docker-compose.dev.yml up -d --wait",
    "dev:db:down": "docker compose -f docker-compose.dev.yml down",
    "dev:setup": "npm run dev:db && npm run db:migrate",
    "dev:all": "concurrently -n web,worker -c blue,green \"npm:dev\" \"npm:worker\"",
    "gpu:verifier": "tsx scripts/gpu-verifier.ts"
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.45.3",
    "img-comparison-slider": "^8.0.7",
    "lucide-react": "^1.52.0",
    "next": "^16.3.6",
    "postgres": "^3.4.5",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/react": "^19.0.2",
    "@types/react-dom": "^19.0.2",
    "concurrently": "^10.0.5",
    "drizzle-kit": "^0.31.11",
    "knip": "^6.45.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
