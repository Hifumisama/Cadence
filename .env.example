# Postgres dédié à Cadence (conteneur propre, pas partagé avec les autres
# stacks du homelab — voir plan d'implémentation, "portabilité").
DATABASE_URL=postgres://cadence:cadence@postgres:5432/cadence
POSTGRES_USER=cadence
POSTGRES_PASSWORD=cadence
POSTGRES_DB=cadence

# Racine du stockage média — pointe sur le partage NFS déjà monté sur le
# mini PC. En local (hors Docker), pointer vers un dossier de travail.
MEDIA_ROOT=/data

# Chemin HÔTE (sur le mini PC) du partage NFS déjà monté, à bind-mount dans
# les conteneurs web/worker sur /data. Ex. /mnt/nas/cadence
NFS_MEDIA_PATH=/mnt/nas/cadence

# API ComfyUI, exposée depuis le PC de bureau via NPM. Mode "stub" tant que
# workflows/video-generation/VID_REF2VA.json n'est pas ré-exporté en format
# API (voir plan d'implémentation, "Prérequis bloquant") — passer à "http"
# une fois l'export propre disponible.
COMFYUI_MODE=stub
COMFYUI_URL=https://comfyui.example.ts.net
COMFYUI_WORKFLOW_PATH=./workflows/video-generation/VID_REF2VA.json

WORKER_INTERVAL_MS=10000
