# Valeurs de DÉVELOPPEMENT LOCAL — web et worker tournent sur la machine
# (npm run dev / npm run worker), Postgres tourne dans Docker
# (docker-compose.dev.yml), d'où "localhost" plutôt que "postgres".
DATABASE_URL=postgres://cadence:cadence@localhost:5432/cadence
POSTGRES_USER=cadence
POSTGRES_PASSWORD=cadence
POSTGRES_DB=cadence

# Racine du stockage média — un dossier de travail local en dev.
MEDIA_ROOT=./data

# "stub" = rendus factices ; "http" = vrai ComfyUI à COMFYUI_URL (workflows/ lus par le worker).
COMFYUI_MODE=stub
COMFYUI_URL=https://comfyui.example.ts.net

WORKER_INTERVAL_MS=10000
# --- Brique LLM (agents de génération, lib/llm/) ---
# Fournisseur : « local » = serveur compatible OpenAI (llama.cpp derrière
# llama-swap, Ollama, LM Studio…). « claude » viendra derrière la même interface.
# Le serveur LLM partage le GPU de la machine avec ComfyUI : en parallèle (carte de 16 Go).
LLM_FOURNISSEUR=local
LLM_LOCAL_URL=https://llamacpp-local.example.ts.net
LLM_LOCAL_MODELE=gemma4-26b-A4B
# Modèle d'un skill précis (nom en majuscules, tirets → _) :
# LLM_MODELE_PLAN_H3=qwen3.6-35b-A3B
# Fiches de plan : Open H3 IR seul (préparation des références et des images, puis compilation). RETOUR ARRIÈRE D'URGENCE vers
# l'ancien skill plan-h3 (web ET worker), tant que le banc de rendu n'est pas fait et que plan-h3 n'est pas retiré :
# CADENCE_MOTEUR_FICHE=plan-h3
# La relecture du scénario (étape « relecture » de l'installateur) veut un modèle qui réfléchit : réflexion active par défaut.
# LLM_MODELE_RELECTURE_SCENARIO=qwen3.6-35b-A3B
# Délai maximal d'un appel (ms) ; LLM_FLUX=0 désactive le flux SSE.
# LLM_TIMEOUT_MS=600000
# LLM_FLUX=1
# Route testée avant de prendre un appel (llama-swap : /health ; LM Studio, Ollama : /v1/models).
# LLM_HEALTH_PATH=/health
# Silence maximal d'un flux avant coupure (ms, 0 = aucun) ; le délai total ci-dessus reste le garde-fou.
# LLM_INACTIVITE_MS=300000
# Serveur injoignable depuis plus longtemps (ms) : les appels en attente échouent, à relancer (0 = attendre sans fin).
# LLM_INJOIGNABLE_MAX_MS=300000

# --- Déploiement (mini PC, docker-compose.yml) ---
# En prod, web/worker/postgres tournent tous en conteneurs sur le même
# réseau Docker : DATABASE_URL doit utiliser le nom de service "postgres"
# comme hôte, et MEDIA_ROOT pointe sur le mount NFS bind-mounté sur /data.
#   DATABASE_URL=postgres://cadence:cadence@postgres:5432/cadence
#   MEDIA_ROOT=/data
#   NFS_MEDIA_PATH=/mnt/nas/cadence   (chemin HÔTE du partage NFS)
# Ce fichier .env de dev n'est pas celui utilisé sur le mini PC — la prod a
# son propre .env, modèle : .env.prod.example (avec docker-compose.prod.yml).

# Corps de requête supplémentaire par skill (JSON) : sert surtout à couper la RÉFLEXION du modèle, dont
# les jetons comptent dans la limite de sortie (sinon le JSON est tronqué et l'appel dure 10 min).
# Par défaut, TOUS les skills partent SANS réflexion (lib/llm/config.ts) ;
# LLM_CORPS_PLAN_H3={} la rétablit pour un skill.
# LLM_CORPS_PLAN_H3={"chat_template_kwargs":{"enable_thinking":false}}
# LLM_CORPS={"chat_template_kwargs":{"enable_thinking":false}}
# Limite de jetons de sortie (défaut 16384), globale ou par skill :
# LLM_MAX_TOKENS=16384
# LLM_MAX_TOKENS_PLAN_H3=16384


# Appels LLM en même temps (défaut 1) : à régler sur le `--parallel` de llama.cpp (3 slots → 3). Les sous-tâches d'une
# création (une par scène, un prompt par asset) se partagent alors les slots.
# LLM_PARALLELE=3
# Contexte TOTAL du serveur (`--ctx-size` de llama.cpp, partagé entre les slots avec un cache KV unifié), en jetons. Le worker n'envoie un appel que si
# la somme estimée des appels en vol y tient : sans cela, trois fiches de plan débordent (« Context size has been exceeded ») et le serveur coupe les flux.
# LLM_CONTEXTE_TOTAL=65536

# Journal d'observation du worker (JSON lignes dans data/journal-worker.jsonl) : tâches, déchargements GPU, VRAM toutes les 2 s
# JOURNAL_WORKER=1

# --- Open H3 IR (compilateur du prompt vidéo d'un plan : « Générer la fiche avec Open H3 IR », docs/PLAN_INTEGRATION_OPEN_H3_IR.md) ---
# Le Python où le paquet `open-h3-ir` est installé. En dev, à défaut, le venv du banc d'essai (h3ir-lab/.venv) est utilisé s'il existe ;
# dans Docker (Dockerfile.worker) c'est /usr/bin/python3. Sans lui, la tâche échoue avec un message qui dit quoi régler.
# H3IR_PYTHON=C:\Users\...\Cadence\h3ir-lab\.venv\Scripts\python.exe
# Point de terminaison OpenAI-compatible du compilateur, /v1 compris (défaut : LLM_LOCAL_URL + /v1). Le modèle est celui du skill de traduction
# (même modèle, pour que llama-swap n'en décharge pas un autre en plein calcul) : il doit lire les images.
# H3IR_LLM_URL=http://localhost:8080/v1
# Délai d'un essai de compilation (défaut 20 min : 600 s par appel LLM, plusieurs appels par essai) ; clé d'API si le serveur en exige une (H3IR_LLM_KEY,
# et non H3IR_LLM_API_KEY, que seul le banc d'essai lit) ; dossier du cache du compilateur.
# H3IR_TIMEOUT_MS=1200000
# H3IR_LLM_KEY=
# H3IR_STATE_DIR=/tmp/h3ir
