# .env de PRODUCTION (mini PC) — à copier en « .env » à côté de docker-compose.prod.yml, puis à remplir.
# Ne jamais le committer ni le mettre dans une image.

# --- Base ---
POSTGRES_USER=cadence
POSTGRES_PASSWORD=change-moi
POSTGRES_DB=cadence
# Hôte « postgres » = le conteneur (pas localhost). Mêmes identifiants que ci-dessus.
DATABASE_URL=postgres://cadence:change-moi@postgres:5432/cadence

# --- Stockage ---
# Dossier DE L'HÔTE (le NAS monté sur le mini PC) qui contient tous les médias de Cadence : il doit exister et être
# inscriptible. Dans les conteneurs il apparaît sur /data (MEDIA_ROOT, fixé par le compose).
NFS_MEDIA_PATH=/mnt/nas/cadence

# --- Accès ---
# Port du site sur le mini PC (3000 est pris par Homepage ; évite 6665-6669, bloqués par les navigateurs).
WEB_PORT=3666

# --- Machine GPU (PC distant, via Tailscale) ---
COMFYUI_MODE=http
COMFYUI_URL=https://comfyui.example.ts.net
WORKER_INTERVAL_MS=10000

# --- LLM (llama-swap sur le PC distant) ---
LLM_FOURNISSEUR=local
LLM_LOCAL_URL=https://llamacpp-local.example.ts.net
# Le modèle que tu utilises sur le PC distant (nom tel que llama-swap le connaît).
LLM_LOCAL_MODELE=
# Autres réglages possibles (LLM_PARALLELE, LLM_CONTEXTE_TOTAL, LLM_MODELE_<SKILL>…) : voir .env.example.
# Open H3 IR n'a rien à régler ici : il réutilise LLM_LOCAL_URL (Python et dossier d'état sont dans l'image).
