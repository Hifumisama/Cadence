// Banc A/B, tour 3 bis : le combat réécrit à la main d'après le retour sur E et F.
//   H : même contenu, 8 plans avec timecodes, coupes raccordées sur le geste, côtés fixés.
//   I : exactement le même contenu en texte libre, SANS timecodes ni numéros de plan (le modèle gère le temps).
//   npx tsx --env-file=.env scripts/ab-combat-reecrit.mts
import { and, eq } from "drizzle-orm";
import { db } from "../db";
import { assets, planPromptSections, planRefs, plans, projects } from "../db/schema";

const CLAUSE =
  "Cinematic anime illustration, refined linework, sophisticated cinematic lighting, atmospheric depth, polished digital rendering, in the visual tradition of Makoto Shinkai and Yoshiyuki Sadamoto.";

const SUBJECT_DEFINITIONS =
  "<Subject 1> is Maya from <Picture 1>, the character sheet of a young dancer and spy with sun-tanned skin, red eyes, a long dark brown ponytail tied with a red band, gold drop earrings, a deep red wrap top with a gold corset and jewelled collar, loose puffed red sleeves, gold armbands, a gold belt over wide red trousers edged with gold, a blue sash, gold sandals and ankle jewelry.\n" +
  "<Subject 2> is the Tenancière from <Picture 2>, the character sheet of a tall, imposing woman in her fifties with a general's straight bearing, black hair streaked with silver pulled into a low knot, wearing a floor-length midnight-blue gown with a high collar and intricate silver patterns.\n" +
  "<Subject 3> is the empty inn corridor in <Picture 3>, a long symmetrical passage of dark carved timber and lattice screens with paper lanterns and polished floorboards, soaked in a constant deep indigo light.\n" +
  "<Subject 4> is the night rooftops of the inn in <Picture 4>, curved tiled roof ridges under a moonlit sky, used only for the final aerial view.\n" +
  "<Subject 5> is the flame effect from <Picture 5>, orange-red tongues of fire with bright yellow cores shedding embers, borrowed here only for its colour, texture and motion.\n" +
  "<Subject 6> is Maya's short combat dagger from <Picture 6>, a straight steel blade with a small brass crossguard and a hilt wrapped in dark brown leather cord.";

const SUMMARY =
  "[reference generation] The target video shows <Subject 2>, the Tenancière, walking down <Subject 3> toward <Subject 1>, Maya, who charges with <Subject 6> wrapped in <Subject 5> and trades kicks, sweeps and strikes with her; the Tenancière deflects every blow at the same even pace, twists the dagger out of Maya's hand and sends it flying into a post, then throws the unarmed Maya through a lattice screen with a single palm strike; Maya rises wrapped in flames and whirls in a pirouette, and a colossal pillar of fire bursts through the ceiling and roof of the inn, wrecking the hall and the rooftops, before collapsing into falling embers.";

const RETENTION_H =
  "<Subject 1> (appears in [Shot 1], [Shot 2], [Shot 3], [Shot 4], [Shot 5], [Shot 6], [Shot 7]): fully_preserved - Maya's face, ponytail and red-and-gold costume are retained in every shot.\n" +
  "<Subject 2> (appears in [Shot 1], [Shot 2], [Shot 3], [Shot 4], [Shot 5], [Shot 6], [Shot 7]): fully_preserved - the Tenancière's bearing and midnight-blue gown with silver patterns are retained.\n" +
  "<Subject 3> (appears in [Shot 1], [Shot 2], [Shot 3], [Shot 4], [Shot 5], [Shot 6], [Shot 7]): fully_preserved - the corridor's carved timber, lanterns and floorboards are retained until the shockwave wrecks them.\n" +
  "<Subject 4> (appears in [Shot 8]): fully_preserved - the curved tiled roofs and the moonlit night sky are retained.\n" +
  "<Subject 5> (appears in [Shot 2], [Shot 3], [Shot 4], [Shot 5], [Shot 6], [Shot 7], [Shot 8]): attribute_transfer - the orange-red colour, texture and motion of the flames pass onto Maya's blade, fists, body and the final pillar; the reference's own framing is not reproduced.\n" +
  "<Subject 6> (appears in [Shot 1], [Shot 2], [Shot 3]): fully_preserved - the dagger's straight blade, brass guard and leather-wrapped hilt are retained.";

const RETENTION_I =
  "<Subject 1> (appears throughout the video): fully_preserved - Maya's face, ponytail and red-and-gold costume are retained all along.\n" +
  "<Subject 2> (appears throughout the video): fully_preserved - the Tenancière's bearing and midnight-blue gown with silver patterns are retained.\n" +
  "<Subject 3> (appears until the final aerial view): fully_preserved - the corridor's carved timber, lanterns and floorboards are retained until the shockwave wrecks them.\n" +
  "<Subject 4> (appears in the final aerial view): fully_preserved - the curved tiled roofs and the moonlit night sky are retained.\n" +
  "<Subject 5> (appears from the dagger's ignition to the end): attribute_transfer - the orange-red colour, texture and motion of the flames pass onto Maya's blade, fists, body and the final pillar; the reference's own framing is not reproduced.\n" +
  "<Subject 6> (appears from the opening to the moment it flies into the post): fully_preserved - the dagger's straight blade, brass guard and leather-wrapped hilt are retained.";

const STAGING =
  "Deep midnight-indigo light soaks the corridor and holds steady; orange light appears only where flames burn and fades the moment each gesture ends. Staging for the whole fight: in every side-on, low and two-person view, Maya is on the left of the frame facing right and the Tenancière is on the right facing left, so the exchange always runs from left to right.";

// ---------------------------------------------------------------- H : timecodes, coupes sur le geste
const H =
  `${CLAUSE} ${STAGING} ` +
  "[Shot 1] A wide static shot, the camera locked and the corridor steady, looks down the full length of <Subject 3> from the middle of the floor, carved timber posts and lattice screens converging on the distant double door, paper lanterns swaying faintly, the polished floorboards holding indigo reflections. <Subject 1>, Maya, stands in the near left foreground in a low dancer's stance, knees soft, weight on the balls of her feet, her right hand resting on the flat leather strap at her belt, her ponytail hanging still. Far down the corridor <Subject 2>, the Tenancière, walks toward her at a slow, even pace, her back straight, both arms hanging relaxed at her sides, her midnight-blue gown swaying with each step, her heels counting the boards. As she comes within about six steps, Maya's weight tips onto her front foot and her right hand closes on the hilt under the strap: the shot ends on the first stride of Maya's charge, her torso already leaning into it. " +
  "[Shot 2] At 00:02.000, Hard cut to a side-on tracking shot at chest height, the camera sliding sideways at Maya's running speed, picking up the same charge in mid-stride: <Subject 1> on the left of the frame, <Subject 2> on the right, a stride apart. Maya's right hand whips <Subject 6> out from under the strap and the steel ignites with <Subject 5>, orange-red flame flowing along the edge as she slashes at the Tenancière's collar in a high arc. The Tenancière's right forearm sweeps the blade outward at the same even pace, the flame splitting into sparks along her silver-patterned sleeve. Maya turns the momentum into a spin on her left foot and whips her right heel at the Tenancière's ribs; the Tenancière's left elbow drops to meet it with a heavy thud that rattles the paper lanterns and lifts a ring of dust off the boards, and the force slides her back one step across the planks, her gown rippling in a single wave, while Maya lands light on the balls of her feet, her ponytail whipping. The shot ends with both facing each other at arm's length, the flame on the blade steady. " +
  "[Shot 3] At 00:04.000, Hard cut to a low-angle two-shot from floor level along the boards, Maya on the left and the Tenancière on the right, continuing the same exchange: <Subject 1> drops into a crouch and whips her right leg in a low dancer's sweep at the Tenancière's ankles, the gold ankle jewelry flashing; the Tenancière lifts her left foot just enough for the leg to pass beneath, her gown hem skimming the planks, and sets it down again with a sharp tap. Maya turns the sweep into a hand-spring off the floor, vaults up and slashes <Subject 6> upward in a rising arc of flame; at the top of the arc the Tenancière's left hand closes around Maya's wrist and twists it, and the dagger leaves Maya's fingers, spinning end over end and trailing a ribbon of <Subject 5>. The camera pans right at fast speed to follow the dagger as it streaks down the corridor and buries itself in a carved timber post with a sharp thunk, flame licking along the wood, the hilt trembling. The shot ends on the trembling hilt. " +
  "[Shot 4] At 00:06.000, Hard cut to a medium side-on two-shot, the camera shaking slightly, Maya on the left and the Tenancière on the right, a stride apart again: <Subject 1>, her hand empty, lets <Subject 5> wrap both fists and attacks in a rapid combination. A jab at the Tenancière's face is turned aside by the back of her right hand; a hooking left to the body is checked by her left forearm with a muffled thud and a burst of sparks; a straight palm strike is deflected upward by a small circle of her wrist. Each deflection throws a curl of flame that scorches a hanging lantern and leaves a glowing mark on the silver sleeve. Maya spins into a back-fist and the Tenancière sways her head back by a hand's width, the fist whistling past, her silver-streaked hair lifting in the wind of it. The Tenancière's right palm then drives flat into Maya's breastbone in one short, dry strike, and the camera shakes strongly: a shockwave of dust and splinters ripples along the boards, Maya's red sleeves snap backward, her gold armbands rattle, her feet leave the floor and embers burst from her back. The shot ends with Maya airborne, flying toward the left edge of the frame. " +
  "[Shot 5] At 00:08.000, Hard cut to a tracking shot ahead of Maya, the camera moving backward at her speed, continuing her flight toward the left-hand wall of the corridor: her back meets a carved lattice screen and the whole panel bursts outward behind her, the wooden latticework exploding into splinters, torn paper fluttering, shards spinning past the lens, and she tumbles through the opening onto the polished boards of an adjoining dark hall, skidding to a stop on her side, embers dying on her sleeves. The shot ends with the broken screen frame behind her and, in its opening on the right of the frame, the blue silhouette of the Tenancière walking toward it at the same even pace. " +
  "[Shot 6] At 00:09.500, Hard cut to a low-angle shot from the floor of the dark hall, looking toward the broken screen on the right of the frame: <Subject 1> pushes herself up, her palm flat on the planks leaving a glowing handprint of <Subject 5> in the wood, and rises in the left foreground as flames climb from her ankles up her legs and sleeves in a rising helix that follows her breathing, her hair lifting in the heat, her red eyes brightening. In the opening of the broken screen <Subject 2> steps through, her gown brushing the splintered frame, her stride keeping the same even pace. The camera pedestals up at medium speed with Maya's rise. The shot ends with Maya at full height, the flame reaching her hair, orange light spilling across the hall's floor and over the Tenancière's face. " +
  "[Shot 7] At 00:11.500, Hard cut to a dive from above: the camera plunges at fast speed toward the middle of the hall where Maya, on the left, leaps and spins on the ball of her foot in a dancer's pirouette, arms flung wide, the flames gathering into a tightening spiral of <Subject 5> around her body, sleeves, hair and sash streaming in the rotation, while the Tenancière, on the right, keeps walking. The spiral accelerates upward and bursts through the ceiling: the beams splinter and fly, roof tiles blast skyward, the paper lanterns pop one after another down the corridor in a chain, and a ring-shaped shockwave of fire and pressure sweeps outward through the hall and the corridor, peeling the floorboards up in a rolling wave, ripping the lattice screens off their frames along both walls, pressing dust flat against the walls and whipping the Tenancière's gown and silver-streaked hair sideways as she holds her stride, her face lit orange. " +
  "[Shot 8] At 00:13.000, Hard cut to a high aerial wide shot above the roofs of the inn, <Subject 4>, the camera swooping up and away at fast speed as a colossal pillar of <Subject 5> erupts out of the broken roof, a spiralling column wider than the building. A ring of shockwave sweeps outward across the rooftops, lifting the tiles in concentric rings, snuffing the paper lanterns along the eaves, toppling chimney tops and scattering glowing embers over the surrounding wings and the underside of the clouds. As the swoop settles into a locked wide frame the pillar collapses downward with the end of Maya's gesture, shrinking into a slow rain of embers over the broken tiles while the indigo moonlight returns. The shot ends with drifting embers and the roof glowing dull red.";

// ---------------------------------------------------------------- I : même contenu, texte libre, sans timecodes ni numéros de plan
