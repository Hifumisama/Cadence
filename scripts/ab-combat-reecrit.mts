const SOUNDSCAPE =
  "Heels counting each step on timber, the rustle of heavy silk, the rasp of a blade leaving leather, a flame that hisses to life and roars with every slash, heavy thuds of blocked kicks and forearms with sparks crackling, the sharp thunk of a dagger striking a post, the dry crack of a palm strike followed by the splintering burst of a lattice screen and fluttering paper, a rising roar of fire and a deep booming shockwave as the ceiling and roof explode, tiles raining, then a long hush of ticking embers.";

const MUSIC =
  "Low sustained bowed strings at a slow tempo with a single deep taiko hit on each of the Tenancière's steps, a rising ostinato of fast plucked strings and snare rolls through the exchange, a hard silence on the palm strike, then a surging brass and full-orchestra crescendo with pounding taiko through the final spin and burst, cutting off at the collapse and leaving one high sustained note that fades.";

const [projet] = await db.select().from(projects).where(eq(projects.nom, "Banc A/B — H3 et Singularity"));
const [modele] = await db.select().from(plans).where(and(eq(plans.projectId, projet!.id), eq(plans.titre, "E — Combat total (15 s)")));
const refsE = await db.select().from(planRefs).where(eq(planRefs.planId, modele!.id));
const existe = await db.select({ id: plans.id }).from(plans).where(and(eq(plans.projectId, projet!.id), eq(plans.titre, "H — Combat réécrit (timecodes)")));
if (existe.length) throw new Error("H existe déjà — rien n'a été écrit.");

const resultat = await db.transaction(async (tx) => {
  const sortie: Record<string, { planId: number; uuid: string; mots: number }> = {};
  const variantes = [
    { cle: "H", titre: "H — Combat réécrit (timecodes)", ordre: 6, desc: H, retention: RETENTION_H, notes: "Tour 3 bis, variante H : le combat réécrit à la main d'après le retour sur E et F. Huit plans à timecodes (0, 2, 4, 6, 8, 9,5, 11,5 et 13 s), coupes raccordées sur le geste, côtés fixés (Maya à gauche, la Tenancière à droite), vrai échange de coups, dague renvoyée, feu final qui détruit le décor. Mêmes images et même seed que E." },
    { cle: "I", titre: "I — Combat réécrit (texte libre)", ordre: 7, desc: I, retention: RETENTION_I, notes: "Tour 3 bis, variante I : exactement le contenu de H, écrit en texte libre, sans timecodes ni numéros de plan : le modèle gère le temps. Mêmes images et même seed que E, H." },
  ];
  for (const v of variantes) {
    const [p] = await tx.insert(plans).values({ projectId: projet!.id, episodeId: modele!.episodeId, sceneId: modele!.sceneId, ordre: v.ordre, titre: v.titre, description: modele!.description, dureeMontageSecondes: 15, dureeGenerationSecondes: 15, fps: 24, seed: modele!.seed, statut: "en_attente", notes: v.notes }).returning();
    await tx.insert(planRefs).values(refsE.map((r) => ({ planId: p!.id, type: r.type, slot: r.slot, assetId: r.assetId, role: r.role, retention: r.retention })));
    await tx.insert(planPromptSections).values([
      { planId: p!.id, section: "subject_definitions", ordre: 1, contenu: SUBJECT_DEFINITIONS },
      { planId: p!.id, section: "summary", ordre: 2, contenu: SUMMARY },
      { planId: p!.id, section: "retention_analysis", ordre: 3, contenu: v.retention },
      { planId: p!.id, section: "detailed_description", ordre: 4, contenu: v.desc },
      { planId: p!.id, section: "overall_soundscape", ordre: 5, contenu: SOUNDSCAPE },
      { planId: p!.id, section: "non_diegetic_music", ordre: 6, contenu: MUSIC },
    ]);
    sortie[v.cle] = { planId: p!.id, uuid: p!.uuid, mots: v.desc.split(/\s+/).length };
  }
  return sortie;
});
console.log(JSON.stringify(resultat, null, 2));
process.exit(0);
