{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Sortie de l'agent brief-projet : le brief validé",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "titre",
    "source",
    "arc",
    "style",
    "langueDialogues",
    "dureeEpisodeSecondes",
    "episodes",
    "personnages",
    "lieux",
    "continuite",
    "rimes",
    "progressions",
    "pieges",
    "inventions",
    "questionsOuvertes"
  ],
  "properties": {
    "titre": {
      "type": "string",
      "minLength": 1
    },
    "source": {
      "type": "string",
      "enum": [
        "pitch",
        "texte",
        "reconstitue"
      ],
      "description": "D'où vient le brief : un pitch, un texte complet, ou un projet existant reconstitué."
    },
    "arc": {
      "type": "string",
      "description": "Deux à quatre phrases : ce que l'histoire raconte et son basculement."
    },
    "genreTon": {
      "type": "string",
      "description": "Genre et ton, en une ou deux phrases."
    },
    "style": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "nom",
        "clause"
      ],
      "properties": {
        "nom": {
          "type": "string",
          "description": "Le style nommé explicitement (animation 2D, live-action cinématographique…)."
        },
        "clause": {
          "type": "string",
          "description": "Une ou deux phrases en anglais, ajoutées telles quelles au début des descriptions vidéo et aux prompts d'images."
        }
      }
    },
    "langueDialogues": {
      "type": "string",
      "description": "French, English…"
    },
    "dureeEpisodeSecondes": {
      "type": "integer",
      "minimum": 30,
      "description": "Durée visée d'un épisode, en secondes."
    },
    "episodes": {
      "type": "array",
      "minItems": 1,
      "description": "Un épisode par entrée. Pour un texte complet : le découpage proposé et validé.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "titre",
          "resume"
        ],
        "properties": {
          "titre": {
            "type": "string"
          },
          "resume": {
            "type": "string",
            "description": "Ce que l'épisode raconte, en quelques phrases."
          },
          "portee": {
            "type": "string",
            "description": "Pour un texte complet : les chapitres ou l'arc couverts."
          }
        }
      }
    },
    "personnages": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "nom",
          "role",
          "reconnaissable"
        ],
        "properties": {
          "nom": {
            "type": "string"
          },
          "role": {
            "type": "string"
          },
          "reconnaissable": {
            "type": "string",
            "description": "Ce qui le rend reconnaissable en une phrase."
          },
          "voix": {
            "type": "string",
            "description": "Impression vocale pressentie, s'il parle. Vide sinon."
          },
          "statut": {
            "type": "string",
            "enum": [
              "fourni",
              "deduit",
              "incertain"
            ],
            "description": "Fourni par l'utilisateur, déduit par toi, ou incertain (reconstitution)."
          }
        }
      }
    },
    "lieux": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "nom",
          "description"
        ],
        "properties": {
          "nom": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "statut": {
            "type": "string",
            "enum": [
              "fourni",
              "deduit",
              "incertain"
            ]
          }
        }
      }
    },
    "continuite": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Règles de continuité : traits qui ne disparaissent jamais, palettes."
    },
    "rimes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "description",
          "souligner"
        ],
        "properties": {
          "description": {
            "type": "string",
            "description": "Les deux moments qui se répondent et ce qui se répète."
          },
          "souligner": {
            "type": "boolean"
          }
        }
      }
    },
    "progressions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "quoi",
          "evolution"
        ],
        "properties": {
          "quoi": {
            "type": "string"
          },
          "evolution": {
            "type": "string"
          }
        }
      }
    },
    "pieges": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "cliche",
          "formulationPositive"
        ],
        "properties": {
          "cliche": {
            "type": "string",
            "description": "Ce que les modèles produisent par défaut sur ce sujet."
          },
          "formulationPositive": {
            "type": "string",
            "description": "Ce qu'on décrit à la place : jamais une négation."
          }
        }
      }
    },
    "inventions": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Tout ce qui n'était pas dans l'entrée. Chaque ligne a été validée par l'utilisateur."
    },
    "questionsOuvertes": {
      "type": "array",
      "items": {
        "type": "string"
      },
      "description": "Ce qui reste incertain. Jamais comblé en silence."
    },
    "statuts": {
      "type": "object",
      "description": "Pour chaque section que tu as remplie (clés : titre, arc, genreTon, style, langueDialogues, dureeEpisodeSecondes, episodes, personnages, lieux, continuite, rimes, progressions, pieges), qui l'a posée : fourni (l'utilisateur l'a dit), deduit (tu l'as conclu), a_valider (tu l'as inventé ou tu hésites).",
      "additionalProperties": {
        "type": "string",
        "enum": [
          "fourni",
          "deduit",
          "a_valider"
        ]
      }
    }
  }
}
