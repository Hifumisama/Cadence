{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Output of the realisateur-analyse agent: what one user message means as operations on an episode",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "decisions",
    "retirer",
    "pistes",
    "retenirPistes",
    "narratif"
  ],
  "properties": {
    "decisions": {
      "type": "array",
      "maxItems": 6,
      "description": "Decisions to keep NOW: precise requests, or the changed version of an existing decision. Empty for a pure feeling, a question, or a choice among pending options.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "titre",
          "raison",
          "operations"
        ],
        "properties": {
          "id": {
            "type": "string",
            "description": "Leave it OUT for a NEW decision. Give the id of an existing decision (D1, D2…) to REPLACE its operations by the complete new list."
          },
          "titre": {
            "type": "string",
            "minLength": 1,
            "description": "(French) A short action phrase, about 60 characters, no figures: « Couper les plans d'ambiance », « Réplique du plan 07 plus sobre »."
          },
          "raison": {
            "type": "string",
            "description": "(French) One sentence: why, in the user's terms."
          },
          "operations": {
            "type": "array",
            "minItems": 1,
            "maxItems": 12,
            "items": {
              "anyOf": [
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "type",
                    "plan"
                  ],
                  "properties": {
                    "type": {
                      "type": "string",
                      "const": "couper_plan"
                    },
                    "plan": {
                      "type": "string",
                      "description": "Reference of the plan concerned, exactly as in the input (P01, P02…)."
                    }
                  }
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "type",
                    "plan",
                    "secondes"
                  ],
                  "properties": {
                    "type": {
                      "type": "string",
                      "const": "duree_plan"
                    },
                    "plan": {
                      "type": "string",
                      "description": "Reference of the plan concerned, exactly as in the input (P01, P02…)."
                    },
                    "secondes": {
                      "type": "integer",
                      "minimum": 5,
                      "maximum": 15,
                      "description": "The new duration in whole seconds, within the limits of the input."
                    }
                  }
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "type",
                    "plan"
                  ],
                  "properties": {
                    "type": {
                      "type": "string",
                      "const": "deplacer_plan"
                    },
                    "plan": {
                      "type": "string",
                      "description": "Reference of the plan concerned, exactly as in the input (P01, P02…)."
                    },
                    "apres": {
                      "type": "string",
                      "description": "Move the plan right AFTER this plan (\"mets le 9 après le 3\" = P03). One placement only: avant, apres or position."
                    },
                    "avant": {
                      "type": "string",
                      "description": "Move the plan right BEFORE this plan (\"mets le 5 avant le 2\" = P02). One placement only: avant, apres or position."
                    },
                    "position": {
                      "type": "string",
                      "description": "\"debut\" or \"fin\": move the plan to the start or the end of the episode. One placement only: avant, apres or position.",
                      "enum": [
                        "debut",
                        "fin"
                      ]
                    }
                  }
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "type",
                    "plan"
                  ],
                  "properties": {
                    "type": {
                      "type": "string",
                      "const": "modifier_plan"
                    },
                    "plan": {
                      "type": "string",
                      "description": "Reference of the plan concerned, exactly as in the input (P01, P02…)."
                    },
                    "titre": {
                      "type": "string",
                      "description": "(French) the new title."
                    },
                    "description": {
                      "type": "string",
                      "description": "(French) the new description, one or two sentences."
                    }
                  }
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "type",
                    "plan"
                  ],
                  "properties": {
                    "type": {
                      "type": "string",
                      "const": "refondre_fiche"
                    },
                    "plan": {
                      "type": "string",
                      "description": "Reference of the plan concerned, exactly as in the input (P01, P02…)."
                    },
                    "consigne": {
                      "type": "string",
                      "description": "(French) What to change in the plan's sheet, in a few words. Empty if the sheet only has to follow the plan as it is now."
                    }
                  }
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "type",
                    "titre",
                    "description",
                    "secondes"
                  ],
                  "properties": {
                    "type": {
                      "type": "string",
                      "const": "ajouter_plan"
                    },
                    "titre": {
                      "type": "string",
                      "description": "(French) the title of the new plan, short."
                    },
                    "description": {
                      "type": "string",
                      "description": "(French) what the new plan shows, one or two sentences."
                    },
                    "secondes": {
                      "type": "integer",
                      "minimum": 5,
                      "maximum": 15,
                      "description": "The duration of the new plan, in whole seconds (\"6s\", \"6 secondes\" = 6)."
                    },
                    "apres": {
                      "type": "string",
                      "description": "The reference of the plan AFTER which the plan is placed (\"après le plan 3\", \"entre le plan 3 et le plan 4\" = P03)."
                    },
                    "avant": {
                      "type": "string",
                      "description": "The reference of the plan BEFORE which the plan is placed (\"juste avant le plan 1\" = P01). Several new plans at the same spot: list them in reading order with the same avant."
                    },
                    "position": {
                      "type": "string",
                      "description": "\"debut\" or \"fin\": the start or the end of the episode.",
                      "enum": [
                        "debut",
                        "fin"
                      ]
                    }
                  }
                }
              ]
            }
          }
        }
      }
    },
    "retirer": {
      "type": "array",
      "maxItems": 6,
      "items": {
        "type": "string"
      },
      "description": "Ids (D1, D2…) of decisions the user withdraws."
    },
    "pistes": {
      "type": "array",
      "maxItems": 3,
      "description": "2 or 3 clearly different options when the user gives a feeling or a problem without a precise action. Each carries its operations, already prepared. Empty otherwise.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "titre",
          "resume",
          "operations"
        ],
        "properties": {
          "titre": {
            "type": "string",
            "minLength": 1,
            "description": "(French) A short phrase naming the option, no figures."
          },
          "resume": {
            "type": "string",
            "description": "(French) One sentence: what it does and what it costs the story. No figure: the application adds the real durations."
          },
          "operations": {
            "type": "array",
            "minItems": 1,
            "maxItems": 14,
            "items": {
              "anyOf": [
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "type",
                    "plan"
                  ],
                  "properties": {
                    "type": {
                      "type": "string",
                      "const": "couper_plan"
                    },
                    "plan": {
                      "type": "string",
                      "description": "Reference of the plan concerned, exactly as in the input (P01, P02…)."
                    }
                  }
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "type",
                    "plan",
                    "secondes"
                  ],
                  "properties": {
                    "type": {
                      "type": "string",
                      "const": "duree_plan"
                    },
                    "plan": {
                      "type": "string",
                      "description": "Reference of the plan concerned, exactly as in the input (P01, P02…)."
                    },
                    "secondes": {
                      "type": "integer",
                      "minimum": 5,
                      "maximum": 15,
                      "description": "The new duration in whole seconds, within the limits of the input."
                    }
                  }
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "type",
                    "plan"
                  ],
                  "properties": {
                    "type": {
                      "type": "string",
                      "const": "deplacer_plan"
                    },
                    "plan": {
                      "type": "string",
                      "description": "Reference of the plan concerned, exactly as in the input (P01, P02…)."
                    },
                    "apres": {
                      "type": "string",
                      "description": "Move the plan right AFTER this plan (\"mets le 9 après le 3\" = P03). One placement only: avant, apres or position."
                    },
                    "avant": {
                      "type": "string",
                      "description": "Move the plan right BEFORE this plan (\"mets le 5 avant le 2\" = P02). One placement only: avant, apres or position."
                    },
                    "position": {
                      "type": "string",
                      "description": "\"debut\" or \"fin\": move the plan to the start or the end of the episode. One placement only: avant, apres or position.",
                      "enum": [
                        "debut",
                        "fin"
                      ]
                    }
                  }
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "type",
                    "plan"
                  ],
                  "properties": {
                    "type": {
                      "type": "string",
                      "const": "modifier_plan"
                    },
                    "plan": {
                      "type": "string",
                      "description": "Reference of the plan concerned, exactly as in the input (P01, P02…)."
                    },
                    "titre": {
                      "type": "string",
                      "description": "(French) the new title."
                    },
                    "description": {
                      "type": "string",
                      "description": "(French) the new description, one or two sentences."
                    }
                  }
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "type",
                    "plan"
                  ],
                  "properties": {
                    "type": {
                      "type": "string",
                      "const": "refondre_fiche"
                    },
                    "plan": {
                      "type": "string",
                      "description": "Reference of the plan concerned, exactly as in the input (P01, P02…)."
                    },
                    "consigne": {
                      "type": "string",
                      "description": "(French) What to change in the plan's sheet, in a few words. Empty if the sheet only has to follow the plan as it is now."
                    }
                  }
                },
                {
                  "type": "object",
                  "additionalProperties": false,
                  "required": [
                    "type",
                    "titre",
                    "description",
                    "secondes"
                  ],
                  "properties": {
                    "type": {
                      "type": "string",
                      "const": "ajouter_plan"
                    },
                    "titre": {
                      "type": "string",
                      "description": "(French) the title of the new plan, short."
                    },
                    "description": {
                      "type": "string",
                      "description": "(French) what the new plan shows, one or two sentences."
                    },
                    "secondes": {
                      "type": "integer",
                      "minimum": 5,
                      "maximum": 15,
                      "description": "The duration of the new plan, in whole seconds (\"6s\", \"6 secondes\" = 6)."
                    },
                    "apres": {
                      "type": "string",
                      "description": "The reference of the plan AFTER which the plan is placed (\"après le plan 3\", \"entre le plan 3 et le plan 4\" = P03)."
                    },
                    "avant": {
                      "type": "string",
                      "description": "The reference of the plan BEFORE which the plan is placed (\"juste avant le plan 1\" = P01). Several new plans at the same spot: list them in reading order with the same avant."
                    },
                    "position": {
                      "type": "string",
                      "description": "\"debut\" or \"fin\": the start or the end of the episode.",
                      "enum": [
                        "debut",
                        "fin"
                      ]
                    }
                  }
                }
              ]
            }
          }
        }
      }
    },
    "retenirPistes": {
      "type": "array",
      "maxItems": 3,
      "items": {
        "type": "integer",
        "minimum": 1,
        "maximum": 3
      },
      "description": "Numbers (from 1) of the pending options the user accepts."
    },
    "narratif": {
      "type": "array",
      "maxItems": 6,
      "description": "Story judgments only you can make (a plan left without purpose, a line left without cause, a contradiction in the story), about a decision of the draft. Empty if you see nothing.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "decision",
          "niveau",
          "texte"
        ],
        "properties": {
          "decision": {
            "type": "string",
            "description": "The id (D1, D2…) of the decision concerned; a new decision uses the next ids announced by prochainId."
          },
          "niveau": {
            "type": "string",
            "enum": [
              "conflit",
              "alerte"
            ]
          },
          "texte": {
            "type": "string",
            "minLength": 1,
            "description": "(French) One sentence naming the plans and lines by their references."
          }
        }
      }
    }
  }
}
