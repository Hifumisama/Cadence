# Copier en .env (ignoré par git). Lu par serveur.py ; une variable déjà définie dans le terminal l'emporte.

# Point de terminaison OpenAI-compatible du llama-swap, /v1 compris
# (c'est la valeur de LLM_LOCAL_URL de Cadence, plus /v1).
H3IR_LLM_URL=https://llamacpp-local.example.ts.net/v1

# Modèle choisi au démarrage ; la page propose ensuite la liste de ceux que llama-swap sert.
H3IR_LLM_MODEL=gemma4-26b-A4B

# Clé d'API, seulement si le serveur en exige une (llama-swap n'en demande pas par défaut).
# H3IR_LLM_API_KEY=   (lu par serveur.py pour la liste des modèles ; le paquet lui-même lit H3IR_LLM_KEY)

# Ports : la page (serveur.py) et le service Open H3 IR qu'elle lance.
H3IR_LAB_PORT=8421
H3IR_PORT=8420

# Décodage guidé : le serveur impose le schéma JSON (grammaire llama.cpp). Sans lui, gemma recopie parfois le schéma au lieu de le remplir
# (erreur 502 "schema-shaped output did not parse" sur les appels avec images).
H3IR_GUIDED_DECODING=1
